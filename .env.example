# Copy to .env and fill in. Never commit .env.

# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to use the bot. Empty = anyone who finds it.
# Send /start to the bot to see your chat id.
ALLOWED_CHAT_IDS=

# Who a meal is logged for when the caption doesn't name anyone
DEFAULT_USER=me

# IANA name, e.g. Asia/Jakarta. Empty = this machine's timezone.
TIMEZONE=

# https://console.anthropic.com -> API keys. Reads the food photos (paid, per photo).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Free key from https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works but is limited to about 30 lookups per hour.
USDA_API_KEY=DEMO_KEY

# "sheets" or "sqlite"
STORAGE_PROVIDER=sheets

# sheets: the id is the long part of the spreadsheet URL, between /d/ and /edit
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# sqlite
SQLITE_PATH=meals.db
